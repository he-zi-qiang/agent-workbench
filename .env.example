# Copy to .env for local development. Never commit .env.
AW_DATABASE__DSN=postgresql+asyncpg://agent:local-only@localhost:5432/agent_workbench
AW_DATABASE__GUARD_DSN=postgresql+asyncpg://agent:local-only@localhost:5432/agent_workbench
AW_DATABASE__LISTEN_DSN=postgresql+asyncpg://agent:local-only@localhost:5432/agent_workbench

# Replace with pinned provider model IDs before a real-model run.
AW_MODEL__MAIN__MODEL_ID=not-configured-sonnet
AW_MODEL__COMPACT__MODEL_ID=not-configured-haiku

# Optional until the Anthropic adapter is implemented.
AW_SECRETS__ANTHROPIC_API_KEY=replace-me-local-only
