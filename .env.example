# Copy to .env for local development. Never commit .env.
#
# **These three are not optional and cannot live in a TOML file.** They are in
# `FORBIDDEN_TOML_PATHS`, so a checkout without a `.env` fails at the *first*
# line of the backend gate with `3 validation errors for LoadedSettings` --
# which reads like a broken checkout and is not one.
#
# Port 5433 and database `agent_workbench_local`, to match what
# `scripts/dev.sh services` actually creates. This file said 5432 and
# `agent_workbench` until 2026-08-31: on a machine with its own PostgreSQL on
# the default port, following it and then running `dev.sh` connected to a
# different server than the one the script had just started -- and the symptom
# was a `role "agent" does not exist` from a server nobody started on purpose.
AW_DATABASE__DSN=postgresql+asyncpg://agent:ci-only@127.0.0.1:5433/agent_workbench_local
AW_DATABASE__GUARD_DSN=postgresql+asyncpg://agent:ci-only@127.0.0.1:5433/agent_workbench_local
AW_DATABASE__LISTEN_DSN=postgresql+asyncpg://agent:ci-only@127.0.0.1:5433/agent_workbench_local

# Pinned DeepSeek model IDs. The tool loop needs a model that supports tool
# calling; verify the current model list against the provider's documentation
# before a real-model run.
AW_MODEL__MAIN__MODEL_ID=deepseek-chat
AW_MODEL__COMPACT__MODEL_ID=deepseek-chat

# The provider key. **Required for anything that calls a model** -- the adapter
# has been implemented and in use for a long time; this line used to say
# "Optional until the DeepSeek adapter is implemented", which was true once.
#
# `replace-me-local-only` is a real placeholder and not a working value: it
# matches `PLACEHOLDER_PREFIXES` in `settings.py`, so copying this file without
# editing this line configures nothing. That is deliberate -- a key-shaped
# string that silently did not work would be worse.
#
# `scripts/dev.sh` reads the key from `AW_SECRETS__DEEPSEEK_API_KEY` or, failing
# that, `AW_KEY_FILE` (default `~/.config/agent-workbench/key`) -- outside the
# checkout on purpose, because `zip -r` and Finder's Compress ignore
# `.gitignore`.
AW_SECRETS__DEEPSEEK_API_KEY=replace-me-local-only
