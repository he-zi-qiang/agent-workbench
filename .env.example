# Copy to .env for local development. Never commit .env.
AW_DATABASE__DSN=postgresql+asyncpg://agent:local-only@localhost:5432/agent_workbench
AW_DATABASE__GUARD_DSN=postgresql+asyncpg://agent:local-only@localhost:5432/agent_workbench
AW_DATABASE__LISTEN_DSN=postgresql+asyncpg://agent:local-only@localhost:5432/agent_workbench

# Pinned DeepSeek model IDs. The tool loop needs a model that supports tool
# calling; verify the current model list against the provider's documentation
# before a real-model run.
AW_MODEL__MAIN__MODEL_ID=deepseek-chat
AW_MODEL__COMPACT__MODEL_ID=deepseek-chat

# Optional until the DeepSeek adapter is implemented.
AW_SECRETS__DEEPSEEK_API_KEY=replace-me-local-only
