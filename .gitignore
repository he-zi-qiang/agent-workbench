.DS_Store
.env
.venv/

# Secret material dropped into the working tree by hand. One key sat here
# untracked and exactly one `git add -A` away from being published; the CI
# secret scan would have caught it in history, which is the wrong end of the
# problem. Provider keys belong in the environment, never in the checkout.
.secrets/
API key/
api-key/
*.key

.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
htmlcov/
.coverage
web/node_modules/
web/dist/
web/coverage/
web/playwright-report/
web/test-results/
var/
artifacts/evidence/

# Copies an editor or a syncing file system leaves beside the original:
# "thing 2.py", "thing copy.md". One pair was committed this way by `git add
# -A` and only removed a release later. No file in this repository is named
# with a space, so nothing deliberate matches these.
* [0-9].*
* [0-9][0-9].*
* copy.*
* ([0-9]).*

# Live git worktrees the desktop app creates for isolated sessions. Each holds
# a `.git` file pointing into this repository's own .git/worktrees, so
# committing one embeds a broken copy of the repository inside itself.
.claude/worktrees/
